@startuml Diagramme de Cas d'Utilisation - Système de Gestion de Pointage

left to right direction

actor "Administrateur" as Admin
actor "Responsable Scanner" as Scanner

rectangle "Système de Gestion de Pointage" {
    usecase "Se connecter" as UC1
    usecase "Gérer le personnel\n(Ajouter, Modifier, Supprimer, Consulter)" as UC2
    usecase "Voir les pointages" as UC3
    usecase "Voir les présents/absents" as UC4
    usecase "Générer des rapports" as UC5
    usecase "Voir les statistiques" as UC6
    usecase "Gérer les heures de travail" as UC7
